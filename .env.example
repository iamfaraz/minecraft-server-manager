# Copy to .env and adjust. All values are optional.
# Docker image name/tag (Docker Hub). publish.sh pushes this name.
MCSM_IMAGE=imfaraz/minecraft-server-manager
MCSM_IMAGE_TAG=latest
MCSM_WEB_PORT=8080
MCSM_JAVA_PORTS=25565-25574
MCSM_BEDROCK_PORTS=19132-19141
MCSM_DATA_DIR=./data
# IP players reach the server on (LAN IP, or public IP when port-forwarded). Used by NetherNet Bedrock servers.
MCSM_ADVERTISE_IP=
# Linux: host networking makes Bedrock LAN discovery and NetherNet work out of the box (set by deploy.sh)
# COMPOSE_FILE=docker-compose.yml:docker-compose.host.yml
MCSM_MEMORY_LIMIT=12g
# Host user that owns ./data (run: id -u ; id -g)
PUID=1000
PGID=1000
